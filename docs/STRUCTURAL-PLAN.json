  "views": [
    {
      "database": "Tasks",
      "name": "All",
      "filter": null,
      "sorts": []
    },
    {
      "database": "Tasks",
      "name": "Today",
      "filter": {
        "and": [
          {
            "and": [
              {
                "property": "Record type",
                "select": {
                  "equals": "Task"
                }
              },
              {
                "property": "Commitment",
                "select": {
                  "equals": "Committed"
                }
              },
              {
                "or": [
                  {
                    "property": "Status",
                    "status": {
                      "equals": "To do"
                    }
                  },
                  {
                    "property": "Status",
                    "status": {
                      "equals": "In progress"
                    }
                  },
                  {
                    "property": "Status",
                    "status": {
                      "equals": "Waiting"
                    }
                  }
                ]
              }
            ]
          },
          {
            "property": "Plan date",
            "date": {
              "equals": "today"
            }
          }
        ]
      },
      "sorts": []
    },
    {
      "database": "Tasks",
      "name": "Upcoming deadlines",
      "filter": {
        "and": [
          {
            "and": [
              {
                "property": "Record type",
                "select": {
                  "equals": "Task"
                }
              },
              {
                "property": "Commitment",
                "select": {
                  "equals": "Committed"
                }
              },
              {
                "or": [
                  {
                    "property": "Status",
                    "status": {
                      "equals": "To do"
                    }
                  },
                  {
                    "property": "Status",
                    "status": {
                      "equals": "In progress"
                    }
                  },
                  {
                    "property": "Status",
                    "status": {
                      "equals": "Waiting"
                    }
                  }
                ]
              }
            ]
          },
          {
            "property": "Due date",
            "date": {
              "is_not_empty": true
            }
          }
        ]
      },
      "sorts": [
        {
          "property": "Due date",
          "direction": "ascending"
        }
      ]
    },
    {
      "database": "Tasks",
      "name": "Waiting",
