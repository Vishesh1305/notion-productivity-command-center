# Local workspace identity and Notion object IDs. Commit manifest.example.json only.
/manifest.json
/manifest.*.json
!/manifest.example.json

# Secrets and local credentials.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.mobileprovision
*.credentials
secrets/
.secrets/

# Private exports, snapshots, generated calendar payloads and job output.
/exports/
/build/
/logs/
/calendar-*.json
*.ics
*.log
*.log.*
*.sqlite
*.sqlite3
*.db

# Python bytecode, environments, packages and test tooling.
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg
*.egg-info/
dist/
site/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml
.hypothesis/

# macOS, editors and local tool state.
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100/
.Trashes/
*.swp
*.swo
*~
.idea/
.vscode/
.fleet/
.history/
.codex/
.agents/

